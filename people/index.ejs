<% 
function normalizeGroup(group) {
if (!group || typeof group !== 'string') {
    return 'Former Members'; // Handle empty or null groups
}
const lowerGroup = group.toLowerCase();
if (lowerGroup.includes('admin')) return 'Admin Support';
if (lowerGroup.includes('faculty')) return 'Faculty';
if (lowerGroup.includes('senior')) return 'Senior Researchers';
if (lowerGroup.includes('post-doc') || lowerGroup.includes('postdoc')) return 'Post-Docs';
if (lowerGroup.includes('graduate')) return 'Graduate Students';
if (lowerGroup.includes('student')) return 'Student';
return 'Other'; 
}

const currentMembers = [];
const formerMembers = [];

for (const item of items) {
// Check if we have the required fields
if (!item.name || !item.group) continue;

// Quarto overrides the slug field with full path (e.g., "people/hong-ge")
// Extract just the last part for the relative link
const slugValue = item.slug || '';
const folderName = slugValue.includes('/') ? slugValue.split('/').pop() : slugValue;

// Extract just the image filename from the full path, or keep full URL if it's a remote image
const imageValue = item.image || '';
const imageFilename = (imageValue.startsWith('http://') || imageValue.startsWith('https://')) 
  ? imageValue 
  : (imageValue.includes('/') ? imageValue.split('/').pop() : imageValue);

const member = {
  name: item.name,
  image: imageFilename, // Just "hong.png", "shravan-goswami.jpg", or full URL for remote images
  tagline: item.tagline,
  group: item.group,
  email: item.email,
  year_arrived: item.year_arrived,
  year_left: item.year_left,
  still_around: item.still_around,
  slug: folderName, // Just "hong-ge", "shravan-goswami", etc.
  links: item.links || {},
  pagetitle: item.pagetitle
};

const normalizedGroup = normalizeGroup(member.group);
if (member.still_around === null || member.still_around === undefined || member.still_around === '') {
continue;
}
if (!member.still_around) {
formerMembers.push({ ...member, group: 'Former Members' });
} else {
currentMembers.push({ ...member, group: normalizedGroup });
}
}

const groupCategories = ['Faculty', 'Senior Researchers', 'Admin Support', 'Post-Docs', 'Graduate Students', 'Visitors', 'Mentor', 'Student', 'Other'];
const groupedMembers = groupCategories.reduce((acc, category) => {
acc[category] = currentMembers.filter(member => member.group === category);
return acc;
}, {});
%>

<!-- Render Current Members by Group -->
<% for (const group of groupCategories) { %>
<% if (groupedMembers[group].length > 0) { %>
::: {.people-section}
::: {.group-title}
<%= group %>
:::
::: {.persons}
<% for (const member of groupedMembers[group]) { %>
::: {.person}
```{=html}
<a href="<%= member.slug %>/">
<img src="<%= member.image.startsWith('http://') || member.image.startsWith('https://') ? member.image : member.slug + '/' + member.image %>" alt="<%= member.name %>" onerror="this.src='../assets/icons/person.webp';">
<p><%= member.pagetitle %></p>
</a>
```
:::
<% } %>
:::
:::
<% } %>
<% } %>

<!-- Render Former Members -->
<% if (formerMembers.length > 0) { %>
::: {.people-section}
::: {.group-title}
Former Members
:::
<ul class="former-members-list">
<% for (const member of formerMembers) { %>
<li><% if (member.links.website) { %><a href="<%= member.links.website %>"><%= member.pagetitle %></a><% } else { %><%= member.pagetitle %><% } %><% if (member.year_arrived || member.year_left) { %> (<%= member.year_arrived ? member.year_arrived : '' %><%= member.year_arrived && member.year_left ? ' - ' : '' %><%= member.year_left ? member.year_left : '' %>)<% } %><% if (member.tagline) { %>, <%= member.tagline %><% } %></li>
<% } %>
</ul>
:::
<% } %>



