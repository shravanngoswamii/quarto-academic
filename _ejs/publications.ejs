```{=html}
<div class="list quarto-listing-default">
    <% for (const item of items) { %>
    
    <div class="quarto-post image-right" <%= metadataAttrs(item) %> >
        <div class="thumbnail">
            <% if (item.image) { %>
            <p>
                <img alt="<%= item.title %>" src="<%= item.image %>" class="thumbnail-image">
            </p>
            <% } %>
        </div>
        <div class="body">
            <div class="no-anchor listing-pub-title listing-title"><%= item.title %></div>
                
            <div class="listing-pub-author listing-author">
                <%= item.author %>
            </div>
            
            <% if (item.abstract) { %>
            <div class="pub-abstract-wrapper" data-pub-id="<%= item.pub_number %>">
                <div class="pub-abstract-preview" data-preview-id="<%= item.pub_number %>">
                    <%- item.abstract %>
                </div>
                <details class="pub-details" data-details-id="<%= item.pub_number %>">
                    <summary class="pub-summary">show more</summary>
                    <div class="pub-abstract-full">
                        <%- item.abstract %>
                        <div class="pub-show-less" onclick="this.closest('.pub-details').removeAttribute('open')">show less</div>
                    </div>
                </details>
            </div>
            <% } %>
            
            <% if (item.bibtex) { %>
            <textarea id="bibtex-<%= item.pub_number %>" class="pub-bibtex-hidden"><%- item.bibtex %></textarea>
            <% } %>
        </div>
        <div class="metadata">
            <div class="pub-date-venue">
                <div class="pub-date-venue-group">
                    <% if (item.year) { %>
                    <span class="pub-date"><%= item.year %>-<%= item.pub_number || '00' %>-<%= item.pub_number || '00' %></span> —
                    <% } %>
                    <% if (item.journ) { %>
                    <span class="pub-venue-badge">
                        <% if (item.journ.includes('arXiv') || item.journ.includes('preprint')) { %>
                        ArXiv (preprint)
                        <% } else { %>
                        <%= item.journ %><% if (item.issue) { %> <%= item.issue %><% } %>
                        <% } %>
                    </span>
                    <% } %>
                    <% if (item.bibtex) { %>
                    <button onclick="copyBibtex('<%= item.pub_number %>')" class="pub-bibtex-button-inline" title="Copy BibTeX citation">
                        <i class="bi bi-quote"></i>
                    </button>
                    <% } %>
                </div>
            </div>
            
            <div class="pub-links">
                <% if (item.url_source) { %>
                <a href="<%- item.url_source %>" target="_blank" rel="noopener" class="pub-link-button">
                    <%= item.url_source.includes('arxiv.org') ? 'arxiv.org' : item.journ && item.journ.includes('arXiv') ? 'arxiv.org' : item.journ || 'source' %> <i class="bi bi-box-arrow-up-right"></i>
                </a>
                <% } %>

                <% if (item.url_preprint && !item.url_source.includes('arxiv.org')) { %>
                <a href="<%- item.url_preprint %>" target="_blank" rel="noopener" class="pub-link-button">
                    arxiv.org <i class="bi bi-box-arrow-up-right"></i>
                </a>
                <% } %>
            </div>
        </div>
    </div>
    
    <% } %>
</div>
```
